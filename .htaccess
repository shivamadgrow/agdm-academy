# ----------------------------------------------------------------------
# AGDM Academy - Optimized & Hardened Server Rules (.htaccess)
# ----------------------------------------------------------------------

# Disable Directory Browsing for Security
Options -Indexes

# Block Access to Hidden Files and Configs
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    DirectoryIndex index.php

    # ✅ Internally route all lp-agdm requests (including spaces and double-encoded URLs) to the actual physical file
    RewriteCond %{REQUEST_URI} lp-agdm [NC]
    RewriteCond %{REQUEST_URI} !lp-agdm-academy\.php$ [NC]
    RewriteRule ^.*$ "lp-agdm-academy.php" [L]

    # ✅ Redirect spam ?items/ URLs to home page cleanly
    RewriteCond %{QUERY_STRING} ^items/ [NC]
    RewriteRule ^.*$ /? [R=301,L]

    # 1. Force HTTPS Redirection
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 2. Redirect External Requests for /page.php to /page (Clean URL Redirect)
    # This prevents duplicate content and enforces clean links
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/([^.]+)\.php [NC]
    RewriteRule ^ %1 [R=301,L]

    # 3. Resolve Clean URLs Internally (Map /page to /page.php)
    # If the request is not a directory and page.php exists as a file, rewrite it
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^([^/]+)$ $1.php [L]
</IfModule>